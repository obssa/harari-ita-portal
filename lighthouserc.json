{
    "ci": {
        "collect": {
            "url": [
                "https://hita.orcamind.dev/en",
                "https://hita.orcamind.dev/am",
                "https://hita.orcamind.dev/en/news",
                "https://hita.orcamind.dev/en/events",
                "https://hita.orcamind.dev/en/documents",
                "https://hita.orcamind.dev/en/about/offices",
                "https://hita.orcamind.dev/en/about/leadership",
                "https://hita.orcamind.dev/en/services",
                "https://hita.orcamind.dev/en/status",
                "https://hita.orcamind.dev/en/support/new",
                "https://hita.orcamind.dev/en/innovation/startups",
                "https://hita.orcamind.dev/en/innovation/programmes",
                "https://hita.orcamind.dev/en/innovation/challenges",
                "https://hita.orcamind.dev/en/projects",
                "https://hita.orcamind.dev/en/projects/public-services-online",
                "https://hita.orcamind.dev/en/data",
                "https://hita.orcamind.dev/en/harar",
                "https://hita.orcamind.dev/en/numbers",
                "https://hita.orcamind.dev/en/developers",
                "https://hita.orcamind.dev/en/academy",
                "https://hita.orcamind.dev/en/academy/courses/digital-literacy-for-public-servants",
                "https://hita.orcamind.dev/en/pillars/digital-government",
                "https://hita.orcamind.dev/en/academy/certificates/verify",
                "https://hita.orcamind.dev/en/opportunities",
                "https://hita.orcamind.dev/en/news/harars-mesob-centre-brings-public-services-under-one-roof",
                "https://hita.orcamind.dev/en/advisories/spot-phishing-messages-before-you-click"
            ],
            "numberOfRuns": 3,
            "settings": {
                "onlyCategories": [
                    "performance",
                    "accessibility",
                    "best-practices"
                ],
                "extraHeaders": "{\"Cache-Control\": \"no-cache\"}"
            }
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "error",
                    {
                        "minScore": 0.9,
                        "aggregationMethod": "median-run"
                    }
                ],
                "categories:accessibility": [
                    "error",
                    {
                        "minScore": 0.9,
                        "aggregationMethod": "median-run"
                    }
                ],
                "categories:best-practices": [
                    "error",
                    {
                        "minScore": 0.9,
                        "aggregationMethod": "median-run"
                    }
                ],
                "resource-summary:document:size": [
                    "error",
                    {
                        "maxNumericValue": 61440
                    }
                ],
                "resource-summary:script:size": [
                    "error",
                    {
                        "maxNumericValue": 81920
                    }
                ],
                "largest-contentful-paint": [
                    "warn",
                    {
                        "maxNumericValue": 2500,
                        "aggregationMethod": "median-run"
                    }
                ],
                "cumulative-layout-shift": [
                    "error",
                    {
                        "maxNumericValue": 0.1,
                        "aggregationMethod": "median-run"
                    }
                ]
            }
        },
        "upload": {
            "target": "filesystem",
            "outputDir": "lighthouse-reports"
        }
    }
}
